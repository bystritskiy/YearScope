# Copy to .env and fill in. The file is gitignored and never lands in the repo.
# Nothing here is required: a source left blank is simply switched off.
#
# To see the interface without a single key: npm run demo

# --- Games: gowithme.club ---
# Player nickname. Without it the source is off.
GOWITHME_PLAYER=

# --- TV shows: myshows ---
# myshows login. History comes from a profile export:
# drop the .xlsx into data/imports/ (the public API only returns the last 25 check-ins).
MYSHOWS_LOGIN=

# --- Movies: Letterboxd ---
# Letterboxd username. Without it the source is off.
LETTERBOXD_USER=

# A TMDB key gives movies their exact runtime.
# Without it, time is computed from an average runtime and marked as an estimate.
# Get one at themoviedb.org → Settings → API.
TMDB_API_KEY=

# --- Books: KoShelf ---
# Address of your KoShelf on the network, e.g. http://192.168.1.10:3003.
# Without it the source is off.
KOSHELF_BASE_URL=

# --- Workouts: intervals.icu ---
# Key and Athlete ID: intervals.icu → Settings → Developer Settings.
# Without the key the source is off.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# --- optional, the defaults are fine ---

# PORT=3010
# YEARSCOPE_YEAR=2026
# SYNC_INTERVAL_MINUTES=1440
# TZ=Europe/Warsaw          # must match the KoShelf time zone
# YEARSCOPE_PORT=3010       # external port in docker compose
