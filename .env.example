# Скопируй в .env и заполни. Файл в .gitignore и в репозиторий не попадает.
# Ничего обязательного здесь нет: незаполненный источник просто выключается.
#
# Посмотреть интерфейс без единого ключа: npm run demo

# --- Игры: gowithme.club ---
# Ник игрока. Без него источник выключен.
GOWITHME_PLAYER=

# --- Сериалы: myshows ---
# Логин на myshows. История берётся из выгрузки профиля:
# положи .xlsx в data/imports/ (публичный API отдаёт лишь 25 последних отметок).
MYSHOWS_LOGIN=

# --- Кино: Letterboxd ---
# Ник на letterboxd. Без него источник выключен.
LETTERBOXD_USER=

# Ключ TMDB — чтобы у фильмов был точный хронометраж.
# Без него время считается по средней длительности и помечается как оценка.
# Берётся на themoviedb.org → Settings → API.
TMDB_API_KEY=

# --- Книги: KoShelf ---
# Адрес твоего KoShelf в сети, например http://192.168.1.10:3003.
# Без него источник выключен.
KOSHELF_BASE_URL=

# --- Тренировки: intervals.icu ---
# Ключ и Athlete ID: intervals.icu → Settings → Developer Settings.
# Без ключа источник выключен.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# --- необязательное, значения по умолчанию подходят ---

# PORT=3010
# YEARSCOPE_YEAR=2026
# SYNC_INTERVAL_MINUTES=1440
# TZ=Europe/Warsaw          # должен совпадать с часовым поясом KoShelf
# YEARSCOPE_PORT=3010       # внешний порт в docker compose
